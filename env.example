# Переменные окружения для Deals Platform на Render.com
# Скопируйте этот файл в .env и заполните реальными значениями

# Настройки базы данных Render.com PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://your-postgres-host.render.com:5432/your-database-name
SPRING_DATASOURCE_USERNAME=your-username
SPRING_DATASOURCE_PASSWORD=your-password

# Spring профиль
SPRING_PROFILES_ACTIVE=postgres

# JWT настройки (опционально)
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRATION=86400000

# Порт приложения
SERVER_PORT=8080
